#!/usr/bin/env php
<?php

$local = dirname(__DIR__).'/contracts/v1/fixtures.json';
$canonicalRoot = getenv('ZAHIR_CONTRACTS_PATH') ?: dirname(__DIR__, 2).'/dep-zahir/contracts';
$canonical = rtrim($canonicalRoot, '/').'/v1/fixtures.json';

$expected = is_file($canonical)
    ? hash_file('sha256', $canonical)
    : trim((string) file_get_contents(dirname(__DIR__).'/contracts/v1/CANONICAL_SHA256'));

if (! hash_equals($expected, hash_file('sha256', $local))) {
    fwrite(STDERR, "Client fixtures differ from canonical Zahir v1 fixtures.\n");
    exit(1);
}

fwrite(STDOUT, "Zahir v1 contract fixtures match.\n");
