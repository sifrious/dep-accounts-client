{
    "name": "sifrious/accounts-client",
    "version": "dev-main",
    "description": "Reusable login and API client contracts for the Accounts service",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "illuminate/http": "^13.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Sifrious\\AccountsClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sifrious\\AccountsClient\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --no-progress",
        "check": [
            "@test",
            "@analyse"
        ],
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
